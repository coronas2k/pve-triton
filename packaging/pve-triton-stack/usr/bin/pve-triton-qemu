#!/bin/sh
# pve-triton-qemu: run the Triton QEMU fork with the correct library
# and host-D3D-backend paths. Coexists with the packaged pve-qemu-kvm.
#
# Usage: pve-triton-qemu [normal qemu-system-x86_64 arguments]
# For a Proxmox VM: qm showcmd <vmid> --show-opts, replace the
# qemu-system-x86_64 path with this wrapper.

if [ -f /etc/pve-triton/env ]; then
	. /etc/pve-triton/env
fi
export LD_LIBRARY_PATH
export NPT_D3D11_LIBRARY_PATH NPT_DXGI_LIBRARY_PATH NPT_D3D12_LIBRARY_PATH

exec /usr/lib/pve-triton/qemu/bin/qemu-system-x86_64 "$@"
