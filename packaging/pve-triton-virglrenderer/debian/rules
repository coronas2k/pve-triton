#!/usr/bin/make -f
# pve-triton-virglrenderer: utmapp/virglrenderer dev/neptune-linux with
# Neptune + Venus enabled, installed to the SYSTEM prefix (/usr) so that
# pve-qemu-kvm's configure picks it up via the default pkg-config path and
# the running /usr/bin/kvm links the Neptune-capable library without any
# LD_LIBRARY_PATH plumbing (PVE launches kvm directly; there is no wrapper
# since the Step 3 pivot). DXVK is a build-time pkg-config dependency
# (virglrenderer.pc Requires.private: dxvk-dxgi) and a runtime dlopen
# dependency (plain names via the ld.so.conf.d drop-in shipped by
# pve-triton-dxvk), both provided by pve-triton-dxvk.

export DEB_BUILD_MAINT_OPTIONS = hardening=+all

export PKG_CONFIG_PATH = /usr/lib/pve-triton/dxvk/lib/x86_64-linux-gnu/pkgconfig

BUILDDIR = builddir
MESON_FLAGS = \
	-Dprefix=/usr \
	-Dplatforms=egl \
	-Dneptune=true \
	-Dvenus=true \
	-Dtests=false \
	-Dc_args=-Wno-error=pedantic \
	-Dcpp_args=-Wno-error=pedantic

# NOTE: -Dplatforms=egl is load-bearing. With 'auto' a missing gbm.pc at
# configure time silently degrades to a GLX-only build (USELESS headless),
# and the fork's QEMU then fails every guest GL command with
# "virgl could not be initialized" — the guest firmware spins forever
# (black display, no network). egl makes the configure error loud.

%:
	dh $@

override_dh_auto_configure:
	# Idempotent: reuse an existing configured build tree across retries.
	test -f $(BUILDDIR)/build.ninja || meson setup $(BUILDDIR) $(MESON_FLAGS)

override_dh_auto_build:
	ninja -C $(BUILDDIR) -j$(shell nproc)

override_dh_auto_install:
	DESTDIR=$(CURDIR)/debian/pve-triton-virglrenderer meson install -C $(BUILDDIR)

override_dh_auto_test:
	# No useful test suite here (-Dtests=false); validated end-to-end
	# by QEMU device realize and the guest driver.

export DEB_BUILD_OPTIONS = noautodbgsym nostrip

override_dh_shlibdeps:
	# Links libdxvk_*.so from pve-triton-dxvk (private layout, no shlibs
	# file); Depends declared manually in debian/control.
	dh_shlibdeps -l/usr/lib/pve-triton/dxvk/lib/x86_64-linux-gnu --dpkg-shlibdeps-params=--ignore-missing-info
