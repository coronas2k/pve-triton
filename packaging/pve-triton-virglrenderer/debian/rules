#!/usr/bin/make -f
# pve-triton-virglrenderer: utmapp/virglrenderer dev/neptune-linux with
# Neptune + Venus enabled. DXVK is a build-time pkg-config dependency
# (virglrenderer.pc Requires.private: dxvk-dxgi) and a runtime dlopen
# dependency (NPT_*_LIBRARY_PATH), both provided by pve-triton-dxvk.

export DEB_BUILD_MAINT_OPTIONS = hardening=+all

export PKG_CONFIG_PATH = /usr/lib/pve-triton/dxvk/lib/x86_64-linux-gnu/pkgconfig

BUILDDIR = builddir
MESON_FLAGS = \
	-Dprefix=/usr/lib/pve-triton/virglrenderer \
	-Dneptune=true \
	-Dvenus=true \
	-Dtests=false \
	-Dc_args=-Wno-error=pedantic \
	-Dcpp_args=-Wno-error=pedantic

%:
	dh $@

override_dh_auto_configure:
	# Idempotent: reuse an existing configured build tree across retries.
	test -f $(BUILDDIR)/build.ninja || meson setup $(BUILDDIR) $(MESON_FLAGS)

override_dh_auto_build:
	ninja -C $(BUILDDIR) -j$(shell nproc)

override_dh_auto_install:
	DESTDIR=$(CURDIR)/debian/pve-triton-virglrenderer meson install -C $(BUILDDIR)

override_dh_auto_test:
	# No useful test suite here (-Dtests=false); validated end-to-end
	# by QEMU device realize and the guest driver.
export DEB_BUILD_OPTIONS = noautodbgsym nostrip

override_dh_shlibdeps:
	# Intra-package private lib (virgl_test_server links libvirglrenderer.so.1
	# from this same package); inter-package Depends are manual in control.
	dh_shlibdeps -l$(CURDIR)/debian/pve-triton-virglrenderer/usr/lib/pve-triton/virglrenderer/lib/x86_64-linux-gnu --dpkg-shlibdeps-params=--ignore-missing-info
